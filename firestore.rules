rules_version = '2';
// KÈO ĐÊ — Firestore security rules
// Dán vào: Firebase Console → Firestore Database → Rules → Publish
service cloud.firestore {
  match /databases/{database}/documents {

    match /keos/{keoId} {
      // ai cũng đọc được bảng tin kèo
      allow read: if true;

      // chỉ người đã đăng nhập (Firebase Auth) mới được tạo kèo
      allow create: if request.auth != null
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.total >= 2
        && request.resource.data.total <= 20
        && request.resource.data.hostUid == request.auth.uid;

      // tham gia/huỷ: phải đăng nhập; chủ kèo không tự thêm/bớt mình khỏi vị trí chủ;
      // admin (custom claim) được sửa mọi kèo
      allow update: if request.auth != null
        && (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'updatedAt'])
            ? (request.auth.uid in request.resource.data.members
               .filter(m, m.uid == request.auth.uid).size() > 0
               || resource.data.members.filter(m, m.uid == request.auth.uid).size() > 0
               || request.auth.token.admin == true)
            : request.auth.uid == resource.data.hostUid || request.auth.token.admin == true);

      // chỉ chủ kèo hoặc admin được xoá
      allow delete: if request.auth != null
        && (resource.data.hostUid == request.auth.uid || request.auth.token.admin == true);
    }
  }
}
