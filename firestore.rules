rules_version = '2';
// KÈO ĐÊ — Firestore security rules v4 (fix: field members → joined khớp app)
// Dán vào: Firebase Console → Firestore Database → Rules → Publish
service cloud.firestore {

  // Admin: Lê Hoàng Vũ = Google account Shark (txt6485@gmail.com)
  function isAdmin() {
    return request.auth != null && request.auth.uid == 'veKx7ZnK0zdqsFqqjMoKQD4pwMW2';
  }

  match /databases/{database}/documents {

    match /keos/{keoId} {
      // ai cũng đọc được bảng tin kèo
      allow read: if true;

      // chỉ người đã đăng nhập mới được tạo kèo (validate dữ liệu cơ bản)
      allow create: if request.auth != null
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.total >= 2
        && request.resource.data.total <= 20
        && request.resource.data.hostUid == request.auth.uid;

      // tham gia/huỷ: chỉ được đổi members/updatedAt, thành viên chỉ tự thêm/bỏ chính mình,
      // host không bị mất khỏi members, không vượt tổng số chỗ.
      // Chủ kèo và admin được sửa toàn bộ kèo.
      allow update: if request.auth != null && (
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['joined', 'updatedAt'])
          && request.resource.data.joined.filter(m, m.uid == request.auth.uid).size() <= 1
          && resource.data.joined.filter(m, m.uid == request.auth.uid).size() <= 1
          && request.resource.data.joined.filter(m, m.uid == resource.data.hostUid).size() == 1
          && request.resource.data.joined.size() <= resource.data.total)
        || request.auth.uid == resource.data.hostUid
        || isAdmin()
      );

      // chỉ chủ kèo hoặc admin được xoá
      allow delete: if request.auth != null
        && (resource.data.hostUid == request.auth.uid || isAdmin());
    }

    // trạng thái "Đã xác minh" — ai cũng xem được badge, chỉ chính chủ hoặc admin ghi
    match /verifications/{uid} {
      allow read: if true;
      allow write: if request.auth != null && (request.auth.uid == uid || isAdmin());
    }

    // hồ sơ CCCD: CHỈ chính chủ và admin được xem; chính chủ gửi/huỷ; admin duyệt thì xoá
    match /kyc/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create, update: if request.auth != null && request.auth.uid == uid;
      allow delete: if request.auth != null && (request.auth.uid == uid || isAdmin());
    }
  }
}
